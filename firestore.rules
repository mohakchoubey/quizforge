rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── TOOLIFY (existing) ──
    match /users/{userId} {
      allow read:
        if request.auth != null;
      allow create, update:
        if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'email'])
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 255
        && (!request.resource.data.keys().hasAny(['rating', 'gamesPlayed', 'wins', 'losses', 'draws'])
            || (request.resource.data.rating is number
                && request.resource.data.gamesPlayed is number
                && request.resource.data.wins is number
                && request.resource.data.losses is number
                && request.resource.data.draws is number));
      allow delete:
        if request.auth != null && request.auth.uid == userId;
    }
    
    match /gameHistory/{docId} {
      allow read:
        if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow create:
        if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.keys().hasAll(['uid', 'myColor', 'opponent', 'result', 'ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.myColor is string
        && (request.resource.data.myColor == 'white' || request.resource.data.myColor == 'black')
        && request.resource.data.opponent is string
        && request.resource.data.opponent.size() > 0
        && request.resource.data.opponent.size() <= 100
        && request.resource.data.result is string
        && (request.resource.data.result == 'win' 
            || request.resource.data.result == 'loss' 
            || request.resource.data.result == 'draw')
        && request.resource.data.ts is timestamp
        && request.resource.data.ts <= request.time;
      allow update: if false;
      allow delete: if false;
    }

    // ── DAY PASSER (existing) ──
    match /dayPasser/{userId}/meta/{document=**} {
      allow read, write:
        if request.auth != null && request.auth.uid == userId;
    }

    match /dayPasser/{userId}/tasks/{document=**} {
      allow read, write:
        if request.auth != null && request.auth.uid == userId;
    }

    match /dayPasser/{userId}/memories/{document=**} {
      allow read, write:
        if request.auth != null && request.auth.uid == userId;
    }

    // ── QUIZFORGE (new) ──
    // Each finished quiz is written as its own doc under
    // /quizforge/{userId}/quizzes/{quizId} — full question text, options,
    // the user's answers, and the AI's explanations all live in that doc.
    // Only the owner can ever read or write their own quizzes.
    match /quizforge/{userId}/quizzes/{quizId} {
      allow read, write:
        if request.auth != null && request.auth.uid == userId;
    }

  }
}
