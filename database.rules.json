{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "history": {
          "$entryId": {
            ".validate": "newData.hasChildren(['score', 'total', 'questions', 'answers', 'createdAt'])"
          }
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
